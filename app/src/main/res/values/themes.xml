<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.MargyTube" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">?attr/colorSurface</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:colorAccent">?attr/colorPrimary</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.MargyTube.Dialog</item>
    </style>

    <style name="ThemeOverlay.MargyTube.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog" />

    <!-- Accent overlays: real Material 3 colour roles, applied before the layout is inflated. -->
    <style name="ThemeOverlay.MargyTube.Green" parent="">
        <item name="colorPrimary">@color/green_primary</item>
        <item name="colorOnPrimary">@color/green_on_primary</item>
        <item name="colorPrimaryContainer">@color/green_container</item>
        <item name="colorOnPrimaryContainer">@color/green_on_container</item>
        <item name="colorSecondary">@color/green_secondary</item>
        <item name="colorOnSecondary">@color/green_on_secondary</item>
        <item name="colorSecondaryContainer">@color/green_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/green_on_secondary_container</item>
        <item name="colorSurfaceTint">@color/green_primary</item>
    </style>

