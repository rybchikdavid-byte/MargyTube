<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="ShapeAppearance.MargyTube.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="TextAppearance.MargyTube.Brand" parent="TextAppearance.Material3.TitleLarge">
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.015</item>
    </style>

    <style name="Widget.MargyTube.Duration" parent="">
        <item name="android:background">@drawable/bg_duration</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">11sp</item>
        <item name="android:paddingLeft">6dp</item>
        <item name="android:paddingRight">6dp</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Widget.MargyTube.Chip" parent="Widget.Material3.Chip.Assist">
        <item name="chipMinHeight">28dp</item>
        <item name="android:textSize">11sp</item>
        <item name="chipIconVisible">false</item>
        <item name="chipStrokeWidth">0dp</item>
    </style>

</resources>
